__pycache__/
*.pyc

# third-party reference clone, kept local only (not vendored)
/HarmBench/
# salted mirror of the above (defensive-reading copy)
/HarmBench_salted/

# data-generation transients (data_writer.py check flags these too)
data/**/.tmp-*
data/**/*.tmp
data/**/*.bak
data/**/*.orig
data/**/*.rej
data/rounds/.lock

# scratch: salted prompts, email manifest/ledger, audit reports, holdouts.
# Kept outside the output root so `check` does not see it, and out of git so
# `salvage --commit` cannot sweep it in.
/work/

# agent instructions are local-only, not part of the project
AGENTS.md