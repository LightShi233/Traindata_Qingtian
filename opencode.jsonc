{
      "$schema": "https://opencode.ai/config.json",
        "provider": {
            "agnes": {
                  "npm": "@ai-sdk/openai-compatible",
                        "name": "Agnes AI",
                              "options": {
                                      "baseURL": "https://apihub.agnes-ai.com/v1",
                                              "apiKey": "{env:AGNES_API_KEY}"
                                                    },
                                                          "models": {
                                                                  "agnes-3.0-flash": {
                                                                            "name": "Agnes 3 Flash",
                                                                                      "limit": { "context": 300000, "output": 65536 }
                                                                                              }
                                                                                                    }
                                                                                                        }
                                                                                                          },
  "permission": "allow"


}
                                                                                                          
